{
  "name": "zikr-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Accounts, sync and daily reminders for the Qur'an Daily Tracker.",
  "scripts": {
    "vapid": "node tools/vapid-keys.js",
    "dev": "wrangler dev",
